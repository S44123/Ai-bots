@bot.callback_query_handler(func=lambda call: (call.data or "").startswith("model:"))
def callback_model(call):
    model = call.data.split(":", 1)[1]
    if model not in MODEL_CHOICES:
        bot.answer_callback_query(call.id, "نموذج غير معروف.")
        return

    session = get_session(call.message.chat.id)
    session["model"] = model
    bot.answer_callback_query(call.id, f"النموذج الآن: {model}")
    try:
        bot.edit_message_reply_markup(
            call.message.chat.id,
            call.message.message_id,
            reply_markup=model_keyboard(model),
        )
    except ApiTelegramException:
        pass


@bot.message_handler(
    content_types=["text"],
    func=lambda message: bool(message.text) and not message.text.startswith("/"),
)
def on_text(message):
    session = get_session(message.chat.id)
    if not session["lock"].acquire(blocking=False):
        bot.reply_to(message, "⏳ انتظر حتى ينتهي الرد السابق.")
        return

    try:
        try:
            bot.send_chat_action(message.chat.id, "typing")
        except ApiTelegramException:
            pass
        placeholder = bot.reply_to(message, "⏳ جاري التفكير…")
        answer, history, used_model, error = call_gemini(
            session["history"],
            message.text,
            session["model"],
        )
        if error:
            bot.edit_message_text(error, message.chat.id, placeholder.message_id)
            return

        session["history"] = history
        session["model"] = used_model
        chunks = split_text(answer)
        try:
            bot.edit_message_text(chunks[0], message.chat.id, placeholder.message_id)
        except ApiTelegramException:
            bot.send_message(message.chat.id, chunks[0])
        for chunk in chunks[1:]:
            bot.send_message(message.chat.id, chunk)
    except Exception as exc:
        print(f"Message handling failed: {type(exc).__name__}: {exc}")
        try:
            bot.send_message(message.chat.id, "حدث خطأ غير متوقع. حاول مرة أخرى.")
        except Exception:
            pass
    finally:
        session["lock"].release()


