def get_session(chat_id):
    now = time.time()
    with _sessions_lock:
        expired = [
            key
            for key, session in _sessions.items()
            if now - session["seen"] > SESSION_TTL_SECONDS
            and not session["lock"].locked()
        ]
        for key in expired:
            del _sessions[key]

        session = _sessions.get(chat_id)
        if session is None:
            session = {
                "history": [],
                "model": GEMINI_MODEL,
                "lock": threading.Lock(),
                "seen": now,
            }
            _sessions[chat_id] = session
        session["seen"] = now
        return session


def split_text(text, limit=TELEGRAM_MESSAGE_LIMIT):
    remaining = text.strip()
    chunks = []
    while len(remaining) > limit:
        cut = remaining.rfind("\n", 0, limit)
        if cut < limit // 2:
            cut = remaining.rfind(" ", 0, limit)
        if cut < limit // 2:
            cut = limit
        chunks.append(remaining[:cut])
        remaining = remaining[cut:].lstrip()
    if remaining:
        chunks.append(remaining)
    return chunks or ["…"]


def _api_error_text(response):
    try:
        data = response.json()
        return str(data.get("error", {}).get("message", ""))[:300]
    except (ValueError, AttributeError):
        return ""


def _post_gemini(contents, model):
    url = f"{GEMINI_API_URL}/{quote(model, safe='-._')}:generateContent"
    response = None
    for attempt in range(2):
        try:
            response = requests.post(
                url,
                headers={
                    "x-goog-api-key": GEMINI_API_KEY,
                    "Content-Type": "application/json",
                },
                json={
                    "contents": contents,
                    "generationConfig": {"maxOutputTokens": MAX_OUTPUT_TOKENS},
                },
                timeout=120,
            )
        except requests.RequestException as exc:
            print(f"Gemini connection failed: {type(exc).__name__}")
            return None, "تعذر الاتصال بخدمة الإجابة. حاول مرة أخرى بعد قليل."

        if response.status_code not in RETRY_STATUSES or attempt == 1:
            break
        time.sleep(1)
    return response, None


def call_gemini(history, user_text, model):
    contents = [
        {
            "role": "model" if message["role"] == "assistant" else "user",
            "parts": [{"text": message["content"]}],
        }
        for message in history
    ]
    contents.append({"role": "user", "parts": [{"text": user_text}]})

    candidates_to_try = [model] + [m for m in MODEL_CHOICES if m != model]
    response = None
    used_model = model
    for candidate in candidates_to_try:
        response, error = _post_gemini(contents, candidate)
        if error:
            return None, None, None, error
        if response.status_code != 404:
            used_model = candidate
            break
        print(f"Gemini model not available: {candidate}")
    else:
        return None, None, None, "النموذج المحدد غير متاح حالياً. جرّب /model لاختيار نموذج آخر."

    if not response.ok:
        code = response.status_code
        print(f"Gemini API returned HTTP {code}: {_api_error_text(response)}")
        if code == 429:
            return None, None, None, "تم تجاوز حد الاستخدام المسموح. حاول بعد قليل."
        if code in (400, 401, 403):
            return None, None, None, f"تعذر إكمال الطلب (HTTP {code}). تحقق من GEMINI_API_KEY وصلاحياته."
        return None, None, None, f"تعذر إكمال الطلب (HTTP {code}). حاول مرة أخرى."

    try:
        payload = response.json()
    except ValueError:
        payload = None
    if not isinstance(payload, dict):
        print("Gemini API returned an invalid JSON response.")
        return None, None, None, "وصل رد غير صالح من الخدمة. حاول مرة أخرى."

    candidates = payload.get("candidates") or []
    candidate = candidates[0] if candidates else {}
    answer_parts = []
    for part in (candidate.get("content") or {}).get("parts") or []:
        text = part.get("text")
        if isinstance(text, str) and text and not part.get("thought", False):
            answer_parts.append(text)
    answer_text = "".join(answer_parts)

    if not answer_text:
        block_reason = (payload.get("promptFeedback") or {}).get("blockReason")
        finish_reason = candidate.get("finishReason")
        print(
            "Gemini API response did not contain text "
            f"(blockReason={block_reason}, finishReason={finish_reason})."
        )
        if block_reason or finish_reason in BLOCKED_FINISH_REASONS:
            return None, None, None, "تعذر الرد على هذا الطلب بسبب فلاتر الأمان."
        return None, None, None, "لم يصل رد نصي. حاول مرة أخرى."

    updated_history = history + [
        {"role": "user", "content": user_text},
        {"role": "assistant", "content": answer_text},
    ]
    updated_history = updated_history[-MAX_HISTORY_MESSAGES:]
    return answer_text, updated_history, used_model, None


def model_keyboard(current):
    keyboard = types.InlineKeyboardMarkup(row_width=1)
    buttons = [
        types.InlineKeyboardButton(
            ("✅ " if model == current else "") + model,
            callback_data=f"model:{model}",
        )
        for model in MODEL_CHOICES
    ]
    keyboard.add(*buttons)
    return keyboard


