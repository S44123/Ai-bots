def connect_to_telegram(max_attempts=5):
    for attempt in range(1, max_attempts + 1):
        try:
            return bot.get_me()
        except ApiTelegramException as exc:
            code = getattr(exc, "error_code", 0)
            if code == 401:
                sys.exit("Telegram rejected TELEGRAM_BOT_TOKEN.")
            print(f"Telegram error (HTTP {code}); attempt {attempt}/{max_attempts}.")
        except requests.RequestException as exc:
            print(f"Telegram connection failed: {type(exc).__name__}; attempt {attempt}/{max_attempts}.")
        time.sleep(5)
    sys.exit("Could not connect to Telegram.")


def main():
    start_health_server()
    me = connect_to_telegram()

    try:
        bot.remove_webhook()
        bot.set_my_commands(
            [
                types.BotCommand("new", "محادثة جديدة"),
                types.BotCommand("model", "اختيار النموذج"),
                types.BotCommand("help", "المساعدة"),
            ]
        )
    except Exception as exc:
        print(f"Could not update Telegram bot settings: {type(exc).__name__}.")

    print(f"Telegram bot is running: @{me.username}")
    first_run = True
    while True:
        skip_pending = first_run
        first_run = False
        try:
            bot.polling(
                non_stop=False,
                skip_pending=skip_pending,
                timeout=30,
                long_polling_timeout=30,
            )
        except KeyboardInterrupt:
            print("Bot stopped.")
            return
        except ApiTelegramException as exc:
            if getattr(exc, "error_code", 0) == 409:
                print("Telegram polling conflict (HTTP 409); standby mode.")
                while True:
                    time.sleep(60)
            print(f"Telegram polling failed (HTTP {getattr(exc, 'error_code', 0)}); retrying in 5 seconds.")
            time.sleep(5)
        except Exception as exc:
            print(f"Polling failed: {type(exc).__name__}; retrying in 5 seconds.")
            time.sleep(5)


if __name__ == "__main__":
    main()
